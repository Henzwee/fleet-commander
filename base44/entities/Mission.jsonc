{
  "name": "Mission",
  "type": "object",
  "properties": {
    "ships": {
      "type": "array",
      "description": "Array of ship IDs assigned to mission (1-3 ships)",
      "items": {
        "type": "object",
        "properties": {
          "shipId": {
            "type": "string"
          },
          "shipName": {
            "type": "string"
          },
          "hourlyPay": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "recalled",
              "destroyed"
            ],
            "default": "active"
          }
        }
      }
    },
    "distance": {
      "type": "number",
      "description": "Distance in light years"
    },
    "duration": {
      "type": "number",
      "description": "Duration in hours"
    },
    "partsReward": {
      "type": "number",
      "description": "Number of parts earned from mission"
    },
    "crystalReward": {
      "type": "number",
      "description": "Number of crystals earned from mission",
      "default": 0
    },
    "isFridayMission": {
      "type": "boolean",
      "description": "Is this a Friday incentive mission",
      "default": false
    },
    "startTime": {
      "type": "string",
      "format": "date-time",
      "description": "Mission start timestamp"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "active",
        "completed",
        "failed"
      ],
      "default": "available",
      "description": "Mission status"
    },
    "fuelCost": {
      "type": "number",
      "description": "Fuel required"
    },
    "description": {
      "type": "string",
      "description": "Mission description"
    },
    "damageHoursChecked": {
      "type": "array",
      "description": "Hours that have been checked for damage",
      "items": {
        "type": "number"
      },
      "default": []
    },
    "encounterResult": {
      "type": "string",
      "description": "Result of encounter event (e.g. '+3 parts', '-50% damage')"
    }
  },
  "required": [
    "ships",
    "distance",
    "duration",
    "partsReward"
  ]
}